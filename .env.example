# 서버 포트
PORT=3000

# 네이버 블로그 ID (예: blog.naver.com/이 부분)
NAVER_BLOG_ID=your_blog_id

# 정보 다양성(뉴스 외 실제 블로그 경험담/관점) 참고용으로 구독할 네이버 블로그
# ID들 (쉼표로 구분, 검색이 아니라 각 블로그의 공식 공개 RSS를 구독하는 방식).
# 대시보드 설정에서도 수정 가능.
NAVER_REFERENCE_BLOG_IDS=

# 무료 스톡 이미지 검색용 (둘 중 하나만 있어도 동작)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
PIXABAY_API_KEY=your_pixabay_api_key

# claude 실행 파일 경로 (보통 그냥 "claude"면 됨. 커스텀 설치 시 절대경로 지정)
CLAUDE_BIN=claude

# 자동 발행 여부 기본값 (true=바로 발행 / false=승인 대기)
DEFAULT_AUTO_PUBLISH=false

# 이미지 소스 기본값: stock | ai | auto
DEFAULT_IMAGE_SOURCE=auto
